COMPOSE_PROJECT_NAME=order-flow
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_CONTAINER_NAME=order-flow-postgres
POSTGRES_PORT=5446
POSTGRES_DB=order_flow
POSTGRES_USER=order_flow
POSTGRES_PASSWORD=change_me

# Keep credentials and port in sync with POSTGRES_* above.
# URL-encode special characters in the username/password.
DATABASE_URL=postgresql://order_flow:change_me@127.0.0.1:5446/order_flow?schema=public
PORT=3000

# Optional: NestJS Observe credentials (never commit real values).
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
